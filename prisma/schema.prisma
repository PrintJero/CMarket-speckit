generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// FR-042/FR-034: closed set so sign-in/session checks can rely on a single
/// enumerated value rather than inferring status from other columns.
enum AccountStatus {
  ACTIVE
  SUSPENDED
}

/// A person's single, global CMarket identity, independent of any community membership.
/// See specs/002-accounts-authentication/data-model.md.
model Account {
  id              String        @id @default(cuid())
  email           String        @unique
  passwordHash    String?
  emailVerifiedAt DateTime?
  /// Optional, self-chosen name shown to fellow community members in place of
  /// the email address (006-user-display-names, FR-001–FR-014).
  displayName     String?
  /// 009-platform-administration, FR-042/FR-043: MASTER-controlled suspend/reactivate.
  status          AccountStatus @default(ACTIVE)
  /// 009-platform-administration, FR-034: set on permanent deletion. The Account
  /// row itself is never deleted — see data-model.md's non-reassignable-attribution
  /// design (research.md #9). Once set, permanent; no path clears it.
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())

  authIdentities      AuthIdentity[]
  sessions            Session[]
  verificationTokens  VerificationToken[]
  memberships         Membership[]
  invitationsSent     Invitation[]         @relation("InvitationsSent")
  listings            Listing[]
  messageThreads      MessageThread[]      @relation("MessageThreadsAsBuyer")
  messagesSent        Message[]            @relation("MessagesSent")
  transactionsRecorded     Transaction[]   @relation("TransactionsRecorded")
  transactionsAsCounterpart Transaction[]  @relation("TransactionsAsCounterpart")
  reviewsWritten            Review[]       @relation("ReviewsWritten")
  reviewsReceived           Review[]       @relation("ReviewsReceived")

  @@map("accounts")
}

/// A federated identity (Google) linked to an Account. FR-015 auto-link is
/// expressed by attaching this row to an existing Account matched by email,
/// rather than always creating a new Account.
model AuthIdentity {
  id                String   @id @default(cuid())
  accountId         String
  provider          String
  providerAccountId String
  linkedAt          DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([accountId])
  @@map("auth_identities")
}

/// A persistent, server-revocable, authenticated instance of an Account signed
/// in on a device. Deleting this row is what "sign out" means (Story 2).
model Session {
  id           String   @id @default(cuid())
  accountId    String
  sessionToken String   @unique
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("sessions")
}

/// A single-use, hashed, expiring credential proving control of the email
/// address on an unverified Account (FR-005, FR-014), and — since security
/// amendment #2 — the sole holder of that sign-up attempt's candidate
/// password until consumption applies it to the Account (FR-019, FR-020).
model VerificationToken {
  id                    String    @id @default(cuid())
  accountId             String
  tokenHash             String    @unique
  candidatePasswordHash String?
  expiresAt             DateTime
  consumedAt            DateTime?
  createdAt             DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("verification_tokens")
}

/// 009-platform-administration, FR-048: closed lifecycle set. ARCHIVED communities
/// are excluded from every ordinary marketplace path (FR-059); SUSPENDED ones keep
/// read/reply access to existing content but block growth (FR-052/FR-053).
enum CommunityStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

/// A tenancy boundary corresponding to a real institution (003-community-creation,
/// FR-001). Never created by end users — see the sole bootstrap exception, Principle I,
/// now joined by Principle IX's managed-provisioning exception (009-platform-administration).
model Community {
  id                String          @id @default(cuid())
  name              String
  createdByOperator String
  createdAt         DateTime        @default(now())
  /// 009-platform-administration, FR-048–FR-065 (data-model.md's state machine).
  status             CommunityStatus @default(ACTIVE)
  suspendedAt        DateTime?
  suspensionReason   String?
  archiveScheduledAt DateTime?
  archivedAt         DateTime?
  /// research.md #8: the community's current "operational generation." Every
  /// Listing/MessageThread/Invitation/Membership row is stamped with this value
  /// at its own creation time; only rows whose stamped epoch matches this
  /// column's *current* value are operational. Incremented by exactly 1 on
  /// every restoration — never otherwise touched.
  operationalEpoch   Int             @default(1)

  memberships Membership[]
  invitations Invitation[]
  listings    Listing[]
  transactions Transaction[]

  @@map("communities")
}

/// FR-010: enumerated, never a bare integer or free-text string, so a future
/// removal/demotion feature can reliably count administrators.
enum MembershipRole {
  ADMINISTRATOR
  MEMBER
}

/// The link between one Account and one Community, carrying a role
/// (003-community-creation). 004-invitations-membership adds the MEMBER role
/// value and the ability to delete (revoke) a row.
model Membership {
  id          String         @id @default(cuid())
  accountId   String
  communityId String
  role        MembershipRole
  createdAt   DateTime       @default(now())
  /// 009-platform-administration, research.md #8: stamped from the community's
  /// operationalEpoch at creation. Never updated thereafter EXCEPT for exactly
  /// one row — the restored administrator's — at the moment of restoration.
  operationalEpoch Int       @default(1)

  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([accountId, communityId])
  @@index([communityId])
  @@map("memberships")
}

/// A single-use credential binding one email address to one Community, issued by
/// that community's administrator (004-invitations-membership, FR-001–FR-005).
/// consumedAt is set either by successful acceptance or by being superseded by a
/// newer invitation to the same (email, communityId) pair (FR-012).
model Invitation {
  id          String    @id @default(cuid())
  communityId String
  email       String
  tokenHash   String    @unique
  invitedBy   String
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  /// 009-platform-administration, research.md #8: stamped from the community's
  /// operationalEpoch at creation; never updated thereafter. A pre-restoration
  /// invitation can never be accepted into a later epoch.
  operationalEpoch Int  @default(1)

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  inviter   Account   @relation("InvitationsSent", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([communityId])
  @@index([email, communityId])
  @@map("invitations")
}

/// FR-004: enumerated, never a bare boolean or free-text string.
/// 011-wanted-posts, FR-005: FULFILLED added, reachable only for kind = WANTED
/// (enforced in listingService.ts, not by the database) and reversible only
/// by the owner (research.md #3 of that feature).
enum ListingStatus {
  ACTIVE
  PAUSED
  FULFILLED
}

/// 011-wanted-posts, research.md #1: a Listing variant discriminator rather
/// than a distinct entity, since MessageThread has no polymorphic-FK path to
/// a second entity in this ORM. Immutable after creation (research.md #5).
enum ListingKind {
  FOR_SALE
  WANTED
}

/// A product offered for sale, or a request for something sought, within
/// exactly one Community (005-product-listings, FR-001–FR-013; coverPhotoId
/// added by the 2026-07-17 amendment, FR-014–FR-017; kind/nullable priceCents
/// added by 011-wanted-posts).
model Listing {
  id            String        @id @default(cuid())
  communityId   String
  ownerId       String
  title         String
  description   String
  /// 011-wanted-posts, FR-003: required and validated when kind = FOR_SALE
  /// (unchanged rule); optional budget ceiling, validated if present, when
  /// kind = WANTED. Enforced in listingService.ts, not by the database.
  priceCents    Int?
  kind          ListingKind   @default(FOR_SALE)
  status        ListingStatus @default(ACTIVE)
  coverPhotoId  String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  /// 009-platform-administration, research.md #8: stamped from the community's
  /// operationalEpoch at creation; never updated thereafter.
  operationalEpoch Int        @default(1)

  community  Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  owner      Account        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  photos     ListingPhoto[] @relation("ListingPhotos")
  coverPhoto ListingPhoto?  @relation("ListingCoverPhoto", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  threads    MessageThread[]

  @@index([communityId, status, createdAt])
  /// 011-wanted-posts, data-model.md: supports the new kind-filtered feed
  /// query at the same performance characteristics as the unfiltered one
  /// (the index above, which the unfiltered query still uses).
  @@index([communityId, kind, status, createdAt])
  @@index([ownerId])
  @@map("listings")
}

/// An image attached to exactly one Listing; removed automatically when its
/// parent listing is deleted (FR-008, SC-006).
model ListingPhoto {
  id         String   @id @default(cuid())
  listingId  String
  data       Bytes
  mimeType   String
  sizeBytes  Int
  position   Int
  createdAt  DateTime @default(now())

  listing        Listing  @relation("ListingPhotos", fields: [listingId], references: [id], onDelete: Cascade)
  /// Back-relation only, for Listing.coverPhotoId (2026-07-17 amendment) — never queried from this side.
  coverOfListing Listing? @relation("ListingCoverPhoto")

  @@index([listingId])
  @@map("listing_photos")
}

/// A conversation between exactly one Listing's owner and one interested buyer,
/// tied to that one listing (008-listing-messaging, FR-001-FR-002). No communityId
/// of its own — every query scopes through the `listing` relation instead
/// (data-model.md, research.md #1), since a listing's community never changes.
model MessageThread {
  id            String   @id @default(cuid())
  listingId     String
  buyerId       String
  createdAt     DateTime @default(now())
  /// The createdAt of this thread's most recent Message, kept current by
  /// insertMessage() (2026-07-17 amendment) — lets Chats/the inbox order by
  /// recent activity via a plain database ORDER BY, never an in-memory sort.
  lastMessageAt DateTime @default(now())
  /// 009-platform-administration, research.md #8: stamped from the community's
  /// operationalEpoch at creation; never updated thereafter.
  operationalEpoch Int   @default(1)

  listing  Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer    Account   @relation("MessageThreadsAsBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@index([lastMessageAt])
  @@map("message_threads")
}

/// A single text message within a MessageThread (FR-003). Append-only — no
/// edit, no delete (spec Out of Scope).
model Message {
  id        String   @id @default(cuid())
  threadId  String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender Account       @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("messages")
}

/// 010-transaction-logging, research.md #5: single value today; a future
/// in-app-payment feature adds IN_APP as a purely additive migration.
enum TransactionPaymentPath {
  OFF_PLATFORM
}

/// 010-transaction-logging, FR-004/FR-005: closed set, never a bare boolean —
/// mirrors ListingStatus's own rationale.
enum TransactionConfirmationState {
  UNCONFIRMED
  CONFIRMED
}

/// A permanent, traceable record that a transaction occurred between two
/// co-members against a specific listing (010-transaction-logging,
/// Constitution Principle IV). No relation to Listing or MessageThread —
/// research.md #1: listingId/listingTitle are an unconstrained snapshot so
/// the log survives listing deletion unaltered (FR-017). communityId is a
/// first-class column, never inferred through a joinable-but-deletable
/// Listing (research.md #1, Constitution Tenancy constraint).
model Transaction {
  id                String                        @id @default(cuid())
  communityId       String
  recorderId        String
  counterpartId     String
  listingId         String
  listingTitle      String
  paymentPath       TransactionPaymentPath        @default(OFF_PLATFORM)
  confirmationState TransactionConfirmationState  @default(UNCONFIRMED)
  createdAt         DateTime                      @default(now())
  confirmedAt       DateTime?
  /// research.md #6: stamped for consistency with every other per-community
  /// row; deliberately never used to filter this model out of any view.
  operationalEpoch  Int                            @default(1)

  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  recorder    Account   @relation("TransactionsRecorded", fields: [recorderId], references: [id], onDelete: Cascade)
  counterpart Account   @relation("TransactionsAsCounterpart", fields: [counterpartId], references: [id], onDelete: Cascade)
  reviews     Review[]

  @@index([communityId])
  @@index([recorderId])
  @@index([counterpartId])
  @@map("transactions")
}

/// A single 1-5 star rating one participant of a CONFIRMED transaction
/// (010-transaction-logging) leaves about the other (012-profiles-reputation).
/// No comment/free-text field (FR-021). No communityId — reputation is
/// computed globally and must never disclose which community a rating came
/// from (FR-011, research.md #2); community only matters transiently at
/// creation, derived through transactionId.
model Review {
  id            String   @id @default(cuid())
  reviewerId    String
  reviewedId    String
  transactionId String
  rating        Int
  createdAt     DateTime @default(now())

  reviewer    Account     @relation("ReviewsWritten", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewed    Account     @relation("ReviewsReceived", fields: [reviewedId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([reviewerId, transactionId])
  @@index([reviewedId])
  @@map("reviews")
}

/// 009-platform-administration, FR-002: closed set for MasterIdentity.status.
enum MasterStatus {
  ACTIVE
  DISABLED
}

/// A dedicated platform-operator identity (009-platform-administration,
/// Constitution Principle IX), wholly separate from Account and Membership —
/// see research.md #1. Never physically deleted (FR-016).
model MasterIdentity {
  id                 String       @id @default(cuid())
  /// Normalized (trim + lowercase, research.md #3) at write time. Immutable
  /// after creation — no update path exists for this field.
  masterId           String       @unique
  /// Operational email. Not a sign-in identifier (FR-003). Unique across
  /// MasterIdentity and, by application-level check, also against
  /// Account.email (research.md #4).
  email              String       @unique
  passwordHash       String
  status             MasterStatus @default(ACTIVE)
  /// true on creation (new MASTER or after a reset); cleared on the first
  /// successful password change (FR-010, FR-011).
  mustChangePassword Boolean      @default(true)
  createdAt          DateTime     @default(now())
  /// Null only for the bootstrap MASTER (FR-007).
  createdByMasterId  String?
  statusChangedAt    DateTime?

  sessions MasterSession[]

  @@map("master_identities")
}

/// An authenticated administrative session belonging only to a MasterIdentity
/// (research.md #1) — never interchangeable with an ordinary Account Session.
model MasterSession {
  id               String   @id @default(cuid())
  masterId         String
  sessionTokenHash String   @unique
  createdAt        DateTime @default(now())
  expiresAt        DateTime

  master MasterIdentity @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@index([masterId])
  @@map("master_sessions")
}

/// 009-platform-administration, FR-069: SYSTEM only for the automatic
/// archival transition; MASTER for every interactive action.
enum AuditActorType {
  MASTER
  SYSTEM
}

/// 009-platform-administration, FR-068: closed set, every consumer benefits
/// from the exhaustiveness check.
enum AuditOutcome {
  SUCCESS
  FAILURE
}

/// Immutable record of every platform-administration action and lifecycle
/// automation event (research.md #6), distinct from the future marketplace
/// transaction log (Constitution Principle IV/IX). Insert-only — no route or
/// service function ever updates or deletes a row (FR-071).
model AdministrativeAuditEntry {
  id            String         @id @default(cuid())
  actorType     AuditActorType
  actorMasterId String?
  /// Plain string, not an enum — this feature alone names 20+ distinct
  /// action shapes and more will be added by future specs (research.md #6).
  /// See the closed TypeScript union AdministrativeAction in auditService.ts.
  action        String
  targetType    String
  targetId      String?
  outcome       AuditOutcome
  /// Sanitized before/after values or failure reason. Never a password, hash,
  /// session token, invitation token, verification token, access code, or
  /// payment credential (FR-070).
  detail        Json?
  createdAt     DateTime       @default(now())

  @@index([createdAt])
  @@index([actorMasterId])
  @@index([targetType, targetId])
  @@map("administrative_audit_entries")
}
