{
  "name": "cmarket",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test:unit": "vitest run tests/unit tests/contract",
    "test:e2e": "playwright test",
    "create-community": "tsx scripts/create-community.ts",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:smoke": "playwright test --config playwright.smoke.config.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "^6.19.3",
    "next": "16.4.6",
    "next-auth": "4.24.15",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.19",
    "prettier": "3.9.5",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true
  }
}
