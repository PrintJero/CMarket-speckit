# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/cmarket?schema=public"

# Auth.js (NextAuth v4)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Google OAuth (Google Cloud Console credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Outbound email (verification links). See src/lib/email/sendEmail.ts.
# In development, leave EMAIL_WEBHOOK_URL unset: emails are logged to the
# console instead of sent. In production, point it at a small provider-specific
# forwarder (Resend/Postmark/SendGrid/etc.) so this feature stays vendor-agnostic.
EMAIL_FROM="CMarket <no-reply@cmarket.example>"
EMAIL_WEBHOOK_URL=""
EMAIL_WEBHOOK_TOKEN=""

# Development-only operator panel (/operator) for community creation (FR-016,
# specs/003-community-creation). Gates a network-reachable path to
# createCommunity() that otherwise MUST NOT exist (FR-002). Leave unset/empty
# locally unless you're using the panel, and this MUST NEVER be set to "true"
# in any real deployment.
OPERATOR_PANEL_ENABLED=""

# Test-only mocked Google OAuth boundary (006-user-display-names, research.md #2).
# Points src/lib/auth/authConfig.ts at a standalone mock server
# (scripts/mock-google-oauth-server.ts) instead of the real Google endpoints, so
# Playwright can drive a real /api/auth/[...nextauth] callback without Google's
# live consent screen. Leave both unset/empty locally unless running that test
# suite, and NEITHER MUST EVER be set in any real deployment.
GOOGLE_OAUTH_MOCK_ENABLED=""
GOOGLE_OAUTH_MOCK_URL=""

# Cloudinary — listing media storage (017-cloudinary-listing-media).
# ALL server-side. There is deliberately NO NEXT_PUBLIC_CLOUDINARY_* variable
# (FR-099): the browser never builds a Cloudinary URL. Images are delivered
# through /api/communities/{communityId}/listing-photos/{photoId}, and the
# upload endpoint is returned at runtime by /api/listing-media/authorize.
# CLOUDINARY_API_SECRET MUST NEVER get a NEXT_PUBLIC_ prefix, be committed, be
# baked into a Docker image, or be logged (FR-098, FR-100).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Top-level asset PATH SEGMENT: development | test | production. Names the first
# segment of the generated public ID (cmarket/{env}/listings/{draftId}/{random}),
# NOT a Cloudinary `folder` upload parameter — no `folder` param is ever sent, so
# behaviour never depends on whether the account is in fixed-folder or
# dynamic-folder mode. This path prefix is what makes it impossible for a staging
# deployment to address or delete production assets (FR-102, FR-103).
CLOUDINARY_ENV_FOLDER="development"

# Delivery cache mode: no-cache (default) | no-store (FR-058).
# A MODE, not a TTL. "no-cache" lets the browser store bytes but forces it to
# revalidate before reuse, so leaving a community or switching accounts is caught
# on the next image request. A max-age is deliberately NOT offered: permitting
# reuse without revalidation is exactly what FR-058 prohibits.
LISTING_IMAGE_CACHE_MODE="no-cache"

# Shared secret for POST /api/listing-media/cleanup, which drains the retryable
# Cloudinary deletion queue. Scheduler-invoked, not session-authenticated.
# Generate with: openssl rand -hex 32
CLEANUP_TOKEN=""

# Test-only Cloudinary verification stub (017-cloudinary-listing-media).
# Playwright intercepts the direct browser-to-Cloudinary upload, so the asset
# never actually reaches Cloudinary and a real Admin API verification would
# correctly fail — making the end-to-end save flow untestable without a live
# account. This replaces ONLY the network call; the public-ID prefix and
# provenance checks (FR-030, FR-031) still run. Leave unset/empty locally unless
# running that suite, and this MUST NEVER be set in any real deployment.
CLOUDINARY_TEST_STUB=""
